@base = http://localhost:5000

### Register
POST {{base}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "Password123!",
  "firstName": "Test",
  "lastName": "User"
}

### Verify email (token comes from the verification email)
POST {{base}}/api/v1/auth/verify-email
Content-Type: application/json

{
  "token": "PASTE_VERIFICATION_TOKEN"
}

### Login
POST {{base}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "Password123!"
}

### Refresh token
POST {{base}}/api/v1/auth/refresh-token
Content-Type: application/json

{
  "refreshToken": "PASTE_REFRESH_TOKEN"
}

@token = PASTE_ACCESS_TOKEN

### Create account
POST {{base}}/api/v1/accounts
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Budget",
  "type": "Spending",
  "allocationPercent": 70
}

### List accounts (add ?includeArchived=true to see archived ones)
GET {{base}}/api/v1/accounts
Authorization: Bearer {{token}}

### Rename account / change type
PUT {{base}}/api/v1/accounts/PASTE_ACCOUNT_ID
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Daily Budget",
  "type": "Spending"
}

### Archive account
DELETE {{base}}/api/v1/accounts/PASTE_ACCOUNT_ID
Authorization: Bearer {{token}}

### Set allocation template (must cover all active accounts, total 100)
PUT {{base}}/api/v1/accounts/template
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "items": [
    { "accountId": "PASTE_ACCOUNT_ID_1", "percent": 70 },
    { "accountId": "PASTE_ACCOUNT_ID_2", "percent": 30 }
  ]
}

### Log income with allocations (must sum to amount)
POST {{base}}/api/v1/incomes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": 30000,
  "source": "Salary",
  "date": "2026-07-28",
  "allocations": [
    { "accountId": "PASTE_ACCOUNT_ID_1", "amount": 21000 },
    { "accountId": "PASTE_ACCOUNT_ID_2", "amount": 9000 }
  ]
}

### Get a single income with its allocation lines
GET {{base}}/api/v1/incomes/PASTE_INCOME_ID
Authorization: Bearer {{token}}

### Log expense
POST {{base}}/api/v1/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "accountId": "PASTE_ACCOUNT_ID",
  "amount": 150,
  "note": "Lunch",
  "category": "Food",
  "date": "2026-07-28"
}

### List expenses (optionally filter with &year=2026&month=7)
GET {{base}}/api/v1/expenses?page=1&pageSize=20
Authorization: Bearer {{token}}

### Dashboard (balances, monthly spend, recent activity; defaults to the current month)
GET {{base}}/api/v1/dashboard?year=2026&month=7
Authorization: Bearer {{token}}

### Set an account's balance (stores the difference as an adjustment)
PUT {{base}}/api/v1/accounts/PASTE_ACCOUNT_ID/balance
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "newBalance": 9500,
  "date": "2026-08-05"
}

### Delete an adjustment (balance reverts)
DELETE {{base}}/api/v1/adjustments/PASTE_ADJUSTMENT_ID
Authorization: Bearer {{token}}

### Categories used so far (for the picker)
GET {{base}}/api/v1/expenses/categories
Authorization: Bearer {{token}}

### Income sources used so far (for suggestions)
GET {{base}}/api/v1/incomes/sources
Authorization: Bearer {{token}}

### Health
GET {{base}}/health
